NODE_ENV=
MES_AIDES_ROOT_URL=

FRANCE_CONNECT_ROOT_URL=
FRANCE_CONNECT_CLIENT_ID=
FRANCE_CONNECT_CLIENT_SECRET=
FRANCE_CONNECT_MESRI_ENDPOINT=

# Token GitHub (classic PAT) du compte bot utilisé pour créer les branches sur le fork et ouvrir les PRs
# Scope requis: public_repo (suffit pour les repos publics)
# GITHUB_OWNER: organisation/compte cible de la PR (ex: DNUM-SocialGouv)
# GITHUB_FORK_OWNER: compte bot qui possède le fork (ex: aides-jeunes-bot) — optionnel, par défaut GITHUB_OWNER
# GITHUB_BASE_BRANCH: branche cible de la PR — optionnel, par défaut: main
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_FORK_OWNER=
GITHUB_BASE_BRANCH=
GITHUB_TOKEN=

MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_PROVIDER=
MCP_REDIRECT_URI=

OPENFISCA_INTERNAL_ROOT_URL=
OPENFISCA_AXE_URL=
OPENFISCA_PUBLIC_ROOT_URL=
OPENFISCA_TRACER_URL=
# Délai d'abandon de l'appel Node -> OpenFisca, en ms (défaut 25000).
# Doit rester inférieur à OPENFISCA_TIMEOUT (secondes, défaut 90).
OPENFISCA_TIMEOUT_MS=
# Idem pour le tracé d'une variable sur un axe, qui empile 141 situations dans
# une seule requête et coûte un multiple d'un calcul ordinaire (défaut 60000).
OPENFISCA_BULK_TIMEOUT_MS=
# Délai gunicorn avant recyclage d'un worker OpenFisca, en secondes (défaut 90).
# Couvre le plus long appel légitime, donc OPENFISCA_BULK_TIMEOUT_MS.
OPENFISCA_TIMEOUT=

PIVOT_URL=

NETLIFY_CONTRIBUTION_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=

MATOMO_ID=
MATOMO_URL=

VITE_STATS_URL=
VITE_STATS_VERSION=

MONGODB_URL=

SENTRY_ORG=
SENTRY_URL=

SENTRY_BACKEND_DSN=
SENTRY_BACKEND_PROJECT=

SENTRY_FRONTEND_DSN=
SENTRY_FRONTEND_PROJECT=

SENTRY_AUTH_TOKEN=
SENTRY_CRON_DSN=

SESSION_SECRET=

MATTERMOST_POST_URL=

PNDS_TOKEN=

SMS_SERVICE_SHOW=
SMS_SERVICE_USERNAME=
SMS_SERVICE_PASSWORD=

DATA_INCLUSION_TOKEN=
